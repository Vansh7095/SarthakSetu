# SarthakSetu — Production Environment Variables
#
# Copy this file to .env and fill in real values.
# Never commit production secrets to version control.
#
# Then run: bash scripts/deploy.sh

# ---------------------------------------------------------------------------
# Public hostname and access mode
# ---------------------------------------------------------------------------
# The public hostname configured in Cloudflare Zero Trust.
# Use one canonical hostname. Do not include https:// or a trailing slash.
# With a Tunnel, Cloudflare creates the DNS route; no A record or port
# forwarding is needed on a phone hotspot.
DOMAIN=sarthaksetu.app

# tunnel = recommended behind a phone hotspot/CGNAT
# direct = Caddy, for a server with reachable inbound TCP 80/443
PUBLIC_MODE=tunnel

# ---------------------------------------------------------------------------
# HTTP ports
# ---------------------------------------------------------------------------
# These are only used by direct/Caddy mode. Tunnel mode does not need inbound
# ports on the host.
HTTP_PORT=80
HTTPS_PORT=443

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# The Docker Compose file generates DATABASE_URL from these values.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=sarthaksetu
# Use only URL-safe characters. Generate one with: openssl rand -hex 32
POSTGRES_PASSWORD=replace_with_openssl_rand_hex_32
POSTGRES_DB=sarthaksetu

# ---------------------------------------------------------------------------
# Clerk Authentication
# ---------------------------------------------------------------------------
# Use Production instance keys from the Clerk Dashboard.
CLERK_PUBLISHABLE_KEY=pk_live_your_key_here
CLERK_SECRET_KEY=sk_live_your_key_here
VITE_CLERK_PUBLISHABLE_KEY=pk_live_your_key_here

# This is the same public hostname served by the Cloudflare Tunnel.
VITE_CLERK_PROXY_URL=https://sarthaksetu.app/api/__clerk
CORS_ORIGIN=https://sarthaksetu.app
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Cloudflare Tunnel
# ---------------------------------------------------------------------------
# In Cloudflare Zero Trust, create a remotely-managed tunnel, add a public
# hostname for DOMAIN, and set its service to http://web:80. Paste the tunnel
# token here. Never commit or share this value.
CLOUDFLARE_TUNNEL_TOKEN=replace_with_cloudflare_tunnel_token